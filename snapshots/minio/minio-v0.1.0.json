    "category": {
      "key": "files",
      "label": "Files \u0026 storage",
      "icon": {
        "type": "lucide",
        "value": "folder-open"
      },
      "order": 20
    },
    "config": {
      "groups": [
        {
          "name": "Endpoint",
          "fields": [
            {
              "key": "endpoint",
              "label": "Endpoint",
              "type": "text",
              "required": true,
              "default": "http://localhost:9000",
              "placeholder": "https://minio.example.com"
            },
            {
              "key": "region",
              "label": "Region",
              "type": "text",
              "required": true,
              "default": "us-east-1"
            },
            {
              "key": "verify_tls",
              "label": "Verify TLS certificate",
              "type": "toggle",
              "default": true
            },
            {
              "key": "path_style",
              "label": "Path-style requests",
              "type": "toggle",
              "default": true
            }
          ]
        },
        {
          "name": "Bucket",
          "fields": [
            {
              "key": "bucket",
              "label": "Bucket",
              "type": "text",
              "required": true,
              "placeholder": "backups"
            },
            {
              "key": "prefix",
              "label": "Prefix",
              "type": "text",
              "placeholder": "optional/folder"
            }
          ]
        },
        {
          "name": "Authentication",
          "fields": [
            {
              "key": "auth",
              "label": "Authentication",
              "type": "select",
              "required": true,
              "default": "access_key",
              "options": [
                {
                  "label": "Access key",
                  "value": "access_key"
                },
                {
                  "label": "Stored access key",
                  "value": "credential"
                }
              ]
            },
            {
              "key": "access_key_id",
              "label": "Access key ID",
              "type": "text",
              "required": true,
              "visibleWhen": {
                "allOf": [
                  {
                    "field": "auth",
                    "op": "eq",
                    "value": "access_key"
                  }
                ]
              }
            },
            {
              "key": "secret_access_key",
              "label": "Secret access key",
              "type": "password",
              "required": true,
              "secret": true,
              "visibleWhen": {
                "allOf": [
                  {
                    "field": "auth",
                    "op": "eq",
                    "value": "access_key"
                  }
                ]
              }
            },
            {
              "key": "session_token",
              "label": "Session token",
              "type": "password",
              "secret": true,
              "visibleWhen": {
                "anyOf": [
                  {
                    "field": "auth",
                    "op": "eq",
                    "value": "access_key"
                  },
                  {
                    "field": "auth",
                    "op": "eq",
                    "value": "credential"
                  }
                ]
              }
            },
            {
              "key": "credential_id",
              "label": "Access key credential",
              "type": "credential_ref",
              "credential": {
                "kind": "cloud_access_key",
                "protocols": [
                  "minio"
                ],
                "required": true
              },
              "visibleWhen": {
                "allOf": [
                  {
                    "field": "auth",
                    "op": "eq",
                    "value": "credential"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "capabilities": [
      "filesystem",
      "object_storage"
    ],
    "supportedTransports": [
      "direct"
    ],
    "layout": "tabs",
    "tabs": [
      {
        "key": "files",
        "label": "Files",
        "icon": {
          "type": "lucide",
          "value": "folder"
        },
        "panel": "file_browser",
        "source": {
          "routeId": "minio.files.list",
          "params": {
            "path": "."
          }
        },
        "config": {
          "pathParam": "path",
          "readRouteId": "minio.files.read",
          "downloadRouteId": "minio.files.download",
          "writeRouteId": "minio.files.write",
          "uploadRouteId": "minio.files.upload",
          "mkdirRouteId": "minio.files.mkdir",
          "renameRouteId": "minio.files.rename",
          "deleteRouteId": "minio.files.delete",
          "writable": true,
          "multipleUpload": true,
          "maxUploadBytes": 52428800,
          "uploadFieldName": "files"
        }
      },
      {
        "key": "buckets",
        "label": "Buckets",
        "icon": {
          "type": "lucide",
          "value": "database"
        },
        "panel": "table",
        "source": {
          "routeId": "minio.buckets.list"
        },
        "config": {
          "columns": [
            {
              "key": "name",
              "label": "Name",
              "sortable": true
            },
            {
              "key": "region",
              "label": "Region",
              "sortable": true
            },
            {
              "key": "createdAt",
              "label": "Created",
              "sortable": true,
              "type": "datetime"
            }
          ],
          "actionIds": [
            "minio.bucket.create"
          ],
          "rowActionIds": [
            "minio.bucket.versioning.set",
            "minio.bucket.delete"
          ],
          "emptyText": "No buckets.",
          "exportable": true
        }
      }
    ],
    "actions": [
      {
        "id": "minio.bucket.create",
        "label": "Create bucket",
        "icon": {
          "type": "lucide",
          "value": "plus"
        },
        "routeId": "minio.bucket.create",
        "method": "POST",
        "risk": "write",
        "requiresConfirm": false,
        "input": {
          "groups": [
            {
              "name": "Bucket",
              "fields": [
                {
                  "key": "name",
                  "label": "Bucket name",
                  "type": "text",
                  "required": true,
                  "placeholder": "my-bucket",
                  "help": "Lowercase letters, numbers, dots and hyphens; 3-63 characters."
                },
                {
                  "key": "region",
                  "label": "Region",
                  "type": "text",
                  "placeholder": "us-east-1"
                }
              ]
            }
          ]
        }
      },
      {
        "id": "minio.bucket.delete",
        "label": "Delete",
        "icon": {
          "type": "lucide",
          "value": "trash-2"
        },
        "routeId": "minio.bucket.delete",
        "method": "DELETE",
        "params": {
          "bucket": "${resource.name}"
        },
        "risk": "destructive",
        "requiresConfirm": true,
        "confirmText": "Delete this bucket? The bucket must be empty."
      },
      {
        "id": "minio.bucket.versioning.set",
        "label": "Set versioning",
        "icon": {
          "type": "lucide",
          "value": "history"
        },
        "routeId": "minio.bucket.versioning.set",
        "method": "PUT",
        "params": {
          "bucket": "${resource.name}"
        },
        "risk": "write",
        "requiresConfirm": false,
        "input": {
          "groups": [
            {
              "name": "Versioning",
              "fields": [
                {
                  "key": "status",
                  "label": "Versioning",
                  "type": "select",
                  "required": true,
                  "options": [
                    {
                      "label": "Enabled",
                      "value": "Enabled"
                    },
                    {
                      "label": "Suspended",
                      "value": "Suspended"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ],

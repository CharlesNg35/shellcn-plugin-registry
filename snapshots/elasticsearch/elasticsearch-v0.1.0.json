    "category": {
      "key": "search",
      "label": "Search",
      "icon": {
        "type": "lucide",
        "value": "search"
      },
      "order": 130
    },
    "config": {
      "groups": [
        {
          "name": "Server",
          "fields": [
            {
              "key": "endpoint",
              "label": "Endpoint",
              "type": "text",
              "required": true,
              "default": "http://localhost:9200",
              "placeholder": "https://search.example.internal:9200"
            }
          ]
        },
        {
          "name": "Authentication",
          "fields": [
            {
              "key": "auth",
              "label": "Authentication",
              "type": "select",
              "required": true,
              "default": "none",
              "options": [
                {
                  "label": "None",
                  "value": "none"
                },
                {
                  "label": "Username and password",
                  "value": "basic"
                },
                {
                  "label": "API key",
                  "value": "api_key"
                },
                {
                  "label": "Bearer token",
                  "value": "bearer"
                },
                {
                  "label": "Stored credential",
                  "value": "credential"
                }
              ]
            },
            {
              "key": "username",
              "label": "Username",
              "type": "text",
              "visibleWhen": {
                "allOf": [
                  {
                    "field": "auth",
                    "op": "eq",
                    "value": "basic"
                  }
                ]
              }
            },
            {
              "key": "password",
              "label": "Password",
              "type": "password",
              "secret": true,
              "visibleWhen": {
                "allOf": [
                  {
                    "field": "auth",
                    "op": "eq",
                    "value": "basic"
                  }
                ]
              }
            },
            {
              "key": "api_key",
              "label": "API key",
              "type": "password",
              "secret": true,
              "visibleWhen": {
                "allOf": [
                  {
                    "field": "auth",
                    "op": "eq",
                    "value": "api_key"
                  }
                ]
              }
            },
            {
              "key": "bearer_token",
              "label": "Bearer token",
              "type": "password",
              "secret": true,
              "visibleWhen": {
                "allOf": [
                  {
                    "field": "auth",
                    "op": "eq",
                    "value": "bearer"
                  }
                ]
              }
            },
            {
              "key": "credential_id",
              "label": "Stored credential",
              "type": "credential_ref",
              "required": true,
              "credential": {
                "kinds": [
                  "basic_auth",
                  "api_token",
                  "bearer_token"
                ],
                "protocols": [
                  "elasticsearch"
                ]
              },
              "visibleWhen": {
                "allOf": [
                  {
                    "field": "auth",
                    "op": "eq",
                    "value": "credential"
                  }
                ]
              }
            }
          ]
        },
        {
          "name": "TLS",
          "fields": [
            {
              "key": "tls_mode",
              "label": "TLS mode",
              "type": "select",
              "required": true,
              "default": "disable",
              "options": [
                {
                  "label": "Disable",
                  "value": "disable"
                },
                {
                  "label": "Require",
                  "value": "require"
                },
                {
                  "label": "Verify CA",
                  "value": "verify-ca"
                },
                {
                  "label": "Verify full",
                  "value": "verify-full"
                }
              ]
            },
            {
              "key": "ca_certificate",
              "label": "CA certificate",
              "type": "textarea",
              "secret": true,
              "visibleWhen": {
                "allOf": [
                  {
                    "field": "tls_mode",
                    "op": "in",
                    "value": [
                      "verify-ca",
                      "verify-full"
                    ]
                  }
                ]
              }
            }
          ]
        },
        {
          "name": "Safety",
          "fields": [
            {
              "key": "read_only",
              "label": "Read-only mode",
              "type": "toggle",
              "default": true,
              "help": "Blocks document writes, index creation, close/open, reindex, and deletes."
            },
            {
              "key": "timeout",
              "label": "Request timeout",
              "type": "duration",
              "default": "10s"
            },
            {
              "key": "page_limit",
              "label": "Page limit",
              "type": "number",
              "default": 100,
              "validators": [
                {
                  "type": "min",
                  "value": 1
                },
                {
                  "type": "max",
                  "value": 500
                }
              ]
            }
          ]
        }
      ]
    },

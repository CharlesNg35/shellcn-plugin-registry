{
  "name": "telnet",
  "version": "0.1.0",
  "apiVersion": 1,
  "protocolVersion": 1,
  "icon": {
    "type": "lucide",
    "value": "square-terminal"
  },
  "projection": {
    "apiVersion": 1,
    "name": "telnet",
    "version": "0.1.0",
    "title": "Telnet",
    "description": "Legacy Telnet terminal access.",
    "icon": {
      "type": "lucide",
      "value": "square-terminal"
    },
    "category": {
      "key": "shell",
      "label": "Shell \u0026 terminal",
      "icon": {
        "type": "lucide",
        "value": "terminal"
      },
      "order": 10
    },
    "config": {
      "groups": [
        {
          "name": "Basic",
          "fields": [
            {
              "key": "host",
              "label": "Host",
              "type": "text",
              "required": true,
              "placeholder": "10.0.0.1"
            },
            {
              "key": "port",
              "label": "Port",
              "type": "number",
              "default": 23,
              "validators": [
                {
                  "type": "min",
                  "value": 1
                },
                {
                  "type": "max",
                  "value": 65535
                }
              ]
            }
          ]
        }
      ]
    },
    "capabilities": [
      "terminal"
    ],
    "supportedTransports": [
      "direct"
    ],
    "layout": "single",
    "tabs": [
      {
        "key": "terminal",
        "label": "Terminal",
        "icon": {
          "type": "lucide",
          "value": "terminal"
        },
        "panel": "terminal",
        "source": {
          "routeId": "telnet.shell",
          "method": "WS",
          "params": {
            "cols": "80",
            "rows": "24"
          }
        },
        "config": {
          "zoom": true,
          "search": true
        }
      }
    ],
    "streams": [
      {
        "id": "telnet.shell",
        "kind": "terminal",
        "routeId": "telnet.shell"
      }
    ],
    "recording": [
      {
        "class": "terminal",
        "formats": [
          "asciicast_v2"
        ],
        "authoritative": true,
        "inputCapture": false
      }
    ]
  }
}
